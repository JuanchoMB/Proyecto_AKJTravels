### 2) USERS  (/api/users/{id})
### ─────────────────────────────────────────────────────────────

# Obtener usuario por id (requiere saber USER_ID)
# @name users_get
GET {{BASE}}/users/{{USER_ID}}
Accept: application/json
Authorization: Bearer {{TOKEN}}

###
# Actualizar datos del usuario
# @name users_update
PUT {{BASE}}/users/{{USER_ID}}
Accept: application/json
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "name": "Kevyn Actualizado",
  "phone": "3007654321"
}

###
# Cambiar contraseña del usuario
# @name users_change_password
PATCH {{BASE}}/users/{{USER_ID}}
Accept: application/json
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "currentPassword": "{{PASS}}",
  "newPassword": "Sup3rStr0ngP@ss!"
}


###
# Listado de reservas del usuario (GET con body SearchBookingDTO)
# Aquí enviamos un cuerpo mínimo {}
# @name users_bookings
GET {{BASE}}/users/{{USER_ID}}/bookings/0
Accept: application/json
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{}

> {%
    /* Intenta extraer BOOKING_ID del primer elemento si el DTO lo trae como .id */
    try {
        const r = JSON.parse(response.body || "{}");
        const arr = (r.data && Array.isArray(r.data)) ? r.data : [];
        if (arr.length && arr[0].id) client.global.set("BOOKING_ID", arr[0].id);
    } catch(e) {}
%}

###
# Lista de alojamientos del host
# @name users_places_host
GET {{BASE}}/users/{{USER_ID}}/places/host/0
Accept: application/json
Authorization: Bearer {{TOKEN}}

> {%
    /* Intenta extraer PLACE_ID del primer lugar (si el DTO trae .id) */
    try {
        const r = JSON.parse(response.body || "{}");
        const arr = (r.data && Array.isArray(r.data)) ? r.data : [];
        if (arr.length && arr[0].id) client.global.set("PLACE_ID", arr[0].id);
    } catch(e) {}
%}

### ─────────────────────────────────────────────────────────────
### 3) PLACES  (/api/places)
### ─────────────────────────────────────────────────────────────

# Crear alojamiento: tu mapping es POST /api/places/{id} pero internamente IGNORA ese {id}
# Usa cualquier string no vacío (p.ej. "me")
# @name places_create
POST {{BASE}}/places/me
Accept: application/json
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "title": "Loft moderno en el centro",
  "description": "Loft amplio, luz natural, parqueadero.",
  "price": 220.0,
  "capacity": 3,
  "placeType": "APARTMENT",
  "accommodationType": "ENTIRE_PLACE",
  "country": "Colombia",
  "department": "Quindío",
  "city": "Armenia",
  "neighborhood": "La Castellana",
  "street": "Calle 10 # 15-22",
  "postalCode": "630001",
  "latitude": 4.5342,
  "longitude": -75.6811
}

###
# Tras crear, vuelve a listar mis places para capturar PLACE_ID
# @name host_places_refresh
GET {{BASE}}/users/{{USER_ID}}/places/host/0
Accept: application/json
Authorization: Bearer {{TOKEN}}

> {%
    try {
        const r = JSON.parse(response.body || "{}");
        const arr = (r.data && Array.isArray(r.data)) ? r.data : [];
        if (arr.length && arr[0].id) client.global.set("PLACE_ID", arr[0].id);
    } catch(e) {}
%}


### -------------------------------------------------------------------
### AUTH – REGISTRO HOST
### -------------------------------------------------------------------
# @name RegisterHost
POST {{base}}/api/auth
Content-Type: application/json

{
  "name": "Host Test",
  "surname": "Demo",
  "email": "host@test.com",
  "phone": "3100000000",
  "birthDate": "1990-01-01",
  "country": "CO",
  "photoUrl": "https://picsum.photos/200",
  "password": "ClaveFuerte1",
  "role": "HOST"
}
> {% client.log("Registro host status: " + response.status); %}

### -------------------------------------------------------------------
### AUTH – REGISTRO USER
### -------------------------------------------------------------------
# @name RegisterUser
POST {{base}}/api/auth
Content-Type: application/json

{
  "name": "User Test",
  "surname": "Demo",
  "email": "user@test.com",
  "phone": "3110000000",
  "birthDate": "1995-02-02",
  "country": "CO",
  "photoUrl": "https://picsum.photos/200",
  "password": "ClaveFuerte1",
  "role": "USER"
}
> {% client.log("Registro user status: " + response.status); %}

### -------------------------------------------------------------------
### LOGIN HOST  → tokenHost
### -------------------------------------------------------------------
# @name LoginHost
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "host@test.com",
  "password": "ClaveFuerte1"
}
> {%
    const token = response.body?.data?.token;
    if (token) client.global.set("tokenHost", token);
    client.log("tokenHost set: " + Boolean(token));
%}

### -------------------------------------------------------------------
### LOGIN USER  → tokenUser
### -------------------------------------------------------------------
# @name LoginUser
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "ClaveFuerte1"
}
> {%
    const token = response.body?.data?.token;
    if (token) client.global.set("tokenUser", token);
    client.log("tokenUser set: " + Boolean(token));
%}

### -------------------------------------------------------------------
### AUTH – ME (USER autenticado)
### -------------------------------------------------------------------
# @name MeUser
GET {{base}}/api/auth/me
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### USERS – COMPLETAR DATOS DE HOST (HostDTO requiere campos)
### -------------------------------------------------------------------
# @name CompleteHost
PUT {{base}}/api/users/{{hostId}}/host
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "about": "Anfitrión de prueba verificado",
  "phone": "3100000000",
  "documentType": "CC",
  "documentNumber": "1234567890",
  "emergencyPhone": "3200000000"
}

### -------------------------------------------------------------------
### USERS – EDITAR PERFIL USER
### -------------------------------------------------------------------
# @name EditUser
PUT {{base}}/api/users/{{userId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "name": "User Test Editado",
  "phone": "3110000001",
  "photoUrl": "https://picsum.photos/300",
  "birthDate": "1995-02-02"
}

### -------------------------------------------------------------------
### USERS – CAMBIAR CONTRASEÑA USER
### -------------------------------------------------------------------
# @name ChangePasswordUser
PATCH {{base}}/api/users/{{userId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "currentPassword": "ClaveFuerte1",
  "newPassword": "ClaveNueva2"
}

### -------------------------------------------------------------------
### PLACES – CREAR LUGAR (HOST)
### -------------------------------------------------------------------
# @name CreatePlace
POST {{base}}/api/places
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "title": "Finca Demo",
  "description": "Hermosa finca de prueba con todo lo necesario.",
  "price": 250000,
  "picsUrl": ["hola"],
  "placeType": "FARM",
  "capacity": 5,
  "country": "CO",
  "department": "Quindío",
  "city": "Armenia",
  "neighborhood": "La Florida",
  "street": "Km 3",
  "postalCode": "630001",
  "amenities": ["WIFI", "PARKING", "POOL"],
  "latitude": 4.533,
  "longitude": -75.681
}
> {%
    // Si tu API devuelve id del lugar en data (string o {id}), descomenta:
    // const id = typeof response.body?.data === 'string' ? response.body.data : response.body?.data?.id;
    // if (id) client.global.set("placeId", id);
%}

### -------------------------------------------------------------------
### IMAGES – SUBIR 2 IMÁGENES (1..10) Y MARCAR PRINCIPAL = 0
### -------------------------------------------------------------------
# @name UploadImages
POST {{base}}/api/places/{{placeId}}/images?mainIndex=0
Authorization: Bearer {{tokenHost}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="foto1.jpg"
Content-Type: image/jpeg

< ./test-assets/foto1.jpg
--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="foto2.jpg"
Content-Type: image/jpeg

< ./test-assets/foto2.jpg
--WebAppBoundary--

### -------------------------------------------------------------------
### PLACES – DETALLE DEL LUGAR
### -------------------------------------------------------------------
# @name PlaceDetail
GET {{base}}/api/places/{{placeId}}/detail

### -------------------------------------------------------------------
### PLACES – AMENIDADES DEL LUGAR
### -------------------------------------------------------------------
# @name PlaceAmenities
GET {{base}}/api/places/{{placeId}}/amenities

### -------------------------------------------------------------------
### PLACES – BÚSQUEDA PAGINADA (?page&size y filtros por query)
### -------------------------------------------------------------------
# @name SearchPlaces
GET {{base}}/api/places?page={{page0}}&size={{size10}}&city=Armenia&minimum=100000&maximum=400000

### -------------------------------------------------------------------
### BOOKINGS – CREAR RESERVA (USER)
### -------------------------------------------------------------------
# @name CreateBooking_ok
POST {{base}}/api/bookings/{{placeId}}
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "checkIn": "2025-11-16T15:00:00",
  "checkOut": "2025-11-18T11:00:00",
  "guest_number": 2
}
> {%
    // Extrae bookingId según el wrapper de tu API: ajusta si tu respuesta difiere
    try {
      const body = JSON.parse(response.body);
      const bid = body?.message?.data?.id || body?.message?.data || body?.data?.id || body?.data || body?.message;
      if (bid) client.global.set("bookingId", bid);
    } catch(e) { }
%}

### -------------------------------------------------------------------
### BOOKINGS – CONFIRMAR RESERVA (HOST)
### -------------------------------------------------------------------
# @name ConfirmBooking
POST {{base}}/api/bookings/{{bookingId}}/confirm
Authorization: Bearer {{tokenHost}}

### -------------------------------------------------------------------
### BOOKINGS – CANCELAR (USER) – OK (>48h si tu dominio lo exige)
### -------------------------------------------------------------------
# @name CancelBooking_ok
DELETE {{base}}/api/bookings/{{bookingId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – ADD (USER)
### -------------------------------------------------------------------
# @name FavAdd
POST {{base}}/api/favorites/{{placeId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – IS MINE? (ResponseBoolean)
### -------------------------------------------------------------------
# @name FavIsMine
GET {{base}}/api/favorites/me/{{placeId}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – LIST MINE (paginado)
### -------------------------------------------------------------------
# @name FavListMine
GET {{base}}/api/favorites/me?page={{page0}}&size={{size10}}
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### FAVORITES – COUNT (público)
### -------------------------------------------------------------------
# @name FavCount
GET {{base}}/api/favorites/count/{{placeId}}

### -------------------------------------------------------------------
### COMMENTS – (NEGATIVO) Crear comentario ANTES de COMPLETED → 400
###  (Ahora el endpoint correcto es por bookingId, NO por place)
### -------------------------------------------------------------------
# @name Comment_beforeCompleted
POST {{base}}/api/bookings/{{bookingId}}/comments
Authorization: Bearer {{tokenUser}}
Content-Type: application/json

{
  "rating": 5,
  "comment": "Excelente!"
}

### -------------------------------------------------------------------
### COMMENTS – LISTAR POR LUGAR (recientes primero, paginado)
### -------------------------------------------------------------------
# @name ListComments
GET {{base}}/api/places/{{placeId}}/comments?page={{page0}}&size={{size10}}

### -------------------------------------------------------------------
### COMMENTS – RESPONDER (HOST)
### -------------------------------------------------------------------
# @name ReplyComment
POST {{base}}/api/comments/{{commentId}}/reply/{{hostId}}
Authorization: Bearer {{tokenHost}}
Content-Type: application/json

{
  "message": "¡Gracias por tu comentario!"
}

### -------------------------------------------------------------------
### STATS – MÉTRICAS DEL LUGAR (HOST)
### -------------------------------------------------------------------
# @name PlaceStats
GET {{base}}/api/places/{{placeId}}/stats?from={{from}}&to={{to}}
Authorization: Bearer {{tokenHost}}

### -------------------------------------------------------------------
### USERS – LISTAR RESERVAS DEL USUARIO (paginado y filtro por query)
### -------------------------------------------------------------------
# @name UserBookings
GET {{base}}/api/users/{{userId}}/bookings?page={{page0}}&size={{size10}}&state=PENDING
Authorization: Bearer {{tokenUser}}

### -------------------------------------------------------------------
### USERS – LISTAR LUGARES DEL HOST (paginado)
### -------------------------------------------------------------------
# @name HostPlaces
GET {{base}}/api/users/{{hostId}}/places/host?page={{page0}}&size={{size10}}
Authorization: Bearer {{tokenHost}}
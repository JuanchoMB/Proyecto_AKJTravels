### ─────────────────────────────────────────────────────────────
### 7) IMAGES
### ─────────────────────────────────────────────────────────────

### Subir imagen (multipart) — AJUSTA la ruta del archivo local
# @name images_upload
POST {{BASE}}/images
Accept: application/json
Authorization: Bearer {{TOKEN}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="foto1.jpg"
Content-Type: image/jpeg

< C:\Users\Public\Pictures\Sample Pictures\Desert.jpg
--WebAppBoundary--

> {%
    /* Guarda REPLY_ID como contenedor genérico de "public_id" si tu servicio lo devuelve en data.id o data.publicId */
    try {
        const r = JSON.parse(response.body || "{}");
        const d = r.data || {};
        const pid = d.id || d.publicId || d.public_id || "";
        if (pid) client.global.set("REPLY_ID", pid);
    } catch(e) {}
%}

###
# Eliminar imagen por id (query param "id")
# @name images_delete
DELETE {{BASE}}/images?id={{REPLY_ID}}
Accept: application/json
Authorization: Bearer {{TOKEN}}


### ─────────────────────────────────────────────────────────────
### VARIABLES
### ─────────────────────────────────────────────────────────────
@HOST = 127.0.0.1
@PORT = 8080
@BASE = http://{{HOST}}:{{PORT}}/api

@EMAIL = kevyn@example.com
@PASS  = 12345678

@TOKEN =
@USER_ID =
@PLACE_ID =
@BOOKING_ID =
@COMMENT_ID =
@REPLY_ID =

### ─────────────────────────────────────────────────────────────
### 1) AUTH
### ─────────────────────────────────────────────────────────────

# Crear usuario: POST /api/auth
# (Tu controlador lo mapea a POST sobre /api/auth SIN /register)
# @name auth_register
POST {{BASE}}/auth
Accept: application/json
Content-Type: application/json

{
  "name": "Kevyn Tester",
  "email": "{{EMAIL}}",
  "password": "{{PASS}}",
  "phone": "3001234567"
}

###
# Login: POST /api/auth/login  (devuelve ResponseDTO<TokenDTO>)
# @name auth_login
POST {{BASE}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{EMAIL}}",
  "password": "{{PASS}}"
}

> {%
    /* Guarda TOKEN desde ResponseDTO<TokenDTO> soportando varios nombres comunes */
    try {
        const r = JSON.parse(response.body || "{}");
        const d = r.data || r;
        const t = d.token || d.accessToken || d.jwt || d.id_token || "";
        if (t) client.global.set("TOKEN", t);

        // Intento de deducir USER_ID desde el JWT (sub / id / userId)
        if (t) {
            const parts = t.split(".");
            if (parts.length >= 2) {
                let payload = parts[1].replace(/-/g, "+").replace(/_/g, "/");
                while (payload.length % 4) payload += "=";
                try {
                    // atob puede no estar; si no, intenta Buffer
                    let json;
                    if (typeof atob === "function") {
                        json = atob(payload);
                    } else if (typeof Buffer !== "undefined") {
                        json = Buffer.from(payload, "base64").toString("utf8");
                    }
                    const obj = JSON.parse(json || "{}");
                    const uid = obj.sub || obj.id || obj.userId || obj.username || "";
                    if (uid) client.global.set("USER_ID", uid);
                } catch (e) { /* sin-op */ }
            }
        }
    } catch(e) { /* sin-op */ }
%}

###
# Forgot password: POST /api/auth/forgot-password
# @name auth_forgot
POST {{BASE}}/auth/forgot-password
Accept: application/json
Content-Type: application/json

{
  "email": "{{EMAIL}}"
}

###
# Reset password: PATCH /api/auth/reset-password
# @name auth_reset
PATCH {{BASE}}/auth/reset-password
Accept: application/json
Content-Type: application/json

{
  "email": "{{EMAIL}}",
  "code": "ABCDEF",
  "newPassword": "NewStr0ngP@ss!"
}

